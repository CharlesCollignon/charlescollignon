# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Windows download markers
*:Zone.Identifier

# Mixamo upload file (regenerate with node scripts/export-mixamo.mjs)
assets/models/robot-tpose.obj

# Sketchfab sources (large; regenerate public/models/humanoid.glb with npm run humanoid:optimize)
assets/models/humanoid_model.zip
assets/models/humanoid-src/
assets/models/humanoid-mixamo.obj
